---
import Dasar from '../layouts/Dasar.astro'
import Status from '../components/Status.astro'
import { PRODUK } from '../data/produk'
---
<Dasar judul="Lapak Kecil">
  <h1>Lapak Kecil</h1>
  {PRODUK.length === 0 ? <Status jenis="kosong" /> : (
    <ul>
      {PRODUK.map(p => <li>{p.nama}: Rp{p.harga.toLocaleString('id-ID')}</li>)}
    </ul>
  )}
</Dasar>
